# Copy this file to instance/important.local.env for local development.
# Never commit the copied file.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET

SENDGRID_API_KEY=PASTE_YOUR_SENDGRID_API_KEY_HERE
SENDGRID_FROM_EMAIL=ali@ytusocial.com
SENDGRID_FROM_NAME=YTUSocial
SENDGRID_REPLY_TO_EMAIL=ali@ytusocial.com
SENDGRID_REPLY_TO_NAME=YTUSocial
SENDGRID_SANDBOX_MODE=true

# Keep the current app behavior unless CSRF enforcement is intentionally enabled
# and all forms/API routes are verified for compatibility.
WTF_CSRF_CHECK_DEFAULT=false
